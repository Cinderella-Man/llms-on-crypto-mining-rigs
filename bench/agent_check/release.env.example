# Machine values for release_check.sh, as used for the v2.0 release check (2026-10-26). Copy it, fill in your own
# hosts, ports and paths, keep the copy out of the repository, and load it before a run:
#   set -a; . my-release.env; set +a
#   STEPS=prep bench/agent_check/release_check.sh <out>    # untimed: files, image, task validation; no rig
#   bench/agent_check/release_check.sh <out>
# The release setup search ran one arm per call, e.g. ARMS=rel CTX=262144 REL_ARGS='-b 512 -ub 128 --pipe-depth 4'
# and ARMS=stock CTX=65536 STOCK_ARGS='-b 2048 -ub 512' (Q8_0 adds -ts 6,6,5,5,6,5,5,6,6 to both);
# docs/data/2026-10-26_release_setup/run/agent_search.sh has every candidate.

# ssh aliases (non-interactive): the rig runs llama-server, the client runs pi, the proxy and the tests in Docker
RIG=rig
CLIENT=client
# llama-server on the rig's loopback
RIG_PORT=8091
# this machine's end of the ssh -L forward (loopback)
RELAY_PORT=8098
# the ssh -R forward's end and the logging proxy, both on the client's loopback
CLIENT_PORT=18391
PROXY_PORT=18392
# folders on the client: the bench files (agent_check/ inside) and the results
CLIENT_DIR=/data/agent-check/bench
CLIENT_OUT=/data/agent-check/out
RIG_LOGDIR=/tmp/agent-check-rel
# on the rig: the two llama-server binaries and the model
STOCK_BIN=/opt/llama-builds/llama.cpp-20261022-d77256999/bin/llama-server
REL_BIN=/opt/llama-builds/llama.cpp-20261025-37e717ff6-pascal-p106-v2-rc4/bin/llama-server
MODEL=/mnt/models/flint-Q8_0.gguf
# both arms in one call, as in the README's table (the search above set these per arm instead)
CTX=65536
STOCK_ARGS="-b 2048 -ub 512"
REL_ARGS="-b 2048 -ub 512 --pipe-depth 3"
# one attempt per task, capped at 12 minutes; no attempt starts after the arm's budget, so the rig slot stays near
# an hour: stock ~25-40 min, the release engine ~12-20 min, two server loads of ~2-4 min
TIME_CAP_MIN=12
BUDGET_MIN_stock=35
BUDGET_MIN_rel=25
