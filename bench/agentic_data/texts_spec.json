    "stopped": {"kind": "note", "command": "stopped", "after": "{seconds} seconds", "wrapped in": "[ ]"},
    "lines_shown": {"kind": "note", "lines shown": "{first} to {last}", "lines in file": "{total}", "wrapped in": "[ ]"},
    "clipped": {"kind": "note", "left out": "middle of output", "characters": "{n}", "wrapped in": "[ ]"},
    "more_entries": {"kind": "note", "listing": "more entries not shown", "wrapped in": "[ ]"},
    "more_matches": {"kind": "note", "search": "more matches not shown", "wrapped in": "[ ]"}
  }
