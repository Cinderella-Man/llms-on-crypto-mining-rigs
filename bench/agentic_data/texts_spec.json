      "write": {"parameters": ["path", "content"], "writes": "whole file", "missing file": "created", "existing content": "replaced"},
      "edit": {"parameters": ["path", "edits"], "edits": "oldText/newText pairs", "each oldText must occur": "exactly once"},
      "bash": {"parameters": ["command", "timeout"], "runs": "shell command", "working folder": "/work", "network": "none", "usable paths": ["/work", "/tmp"], "also used for": "running the tests", "must mention": ["network"]}
    }
