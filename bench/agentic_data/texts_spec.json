  "runners": {
    "unittest": {"prefix": "", "tool": {"parameters": ["target"], "runs": "the project's tests", "command": "python3 -m unittest", "target": "optional"}, "target": {"type": "string", "optional": "yes", "meaning": "tests to run", "default": "all tests", "examples": ["tests.test_shlex", "tests.test_shlex.TestSplit", "tests.test_shlex.TestSplit.test_quotes"]}},
    "pytest": {"prefix": "pytest", "tool": {"parameters": ["target"], "runs": "the project's tests", "command": "python3 -m pytest", "target": "optional"}, "target": {"type": "string", "optional": "yes", "meaning": "tests to run", "default": "all tests", "examples": ["tests/test_core.py", "tests/test_core.py::test_open"]}},
    "mix": {"prefix": "ex", "tool": {"parameters": ["target"], "runs": "the project's tests", "framework": "ExUnit", "command": "mix test", "target": "optional"}, "target": {"type": "string", "optional": "yes", "meaning": "tests to run", "default": "all tests", "examples": ["test/uri_test.exs", "test/uri_test.exs:12"]}}
  },
  "tasks": {
    "python": {
      "write_tests": {"task": "write unit tests", "module": "{module_file}", "new test file": "{test_file}", "framework": "unittest", "cover": ["public functions", "public classes", "edge cases", "errors"], "the module": "stays unchanged", "tests must pass with": "{test_command}", "must mention": ["the module"]},
      "fix_bug": {"task": "fix a bug", "failing tests": "{failing_tests}", "test file": "{test_file}", "bug is in": "{module_file}", "the tests": "stay unchanged", "the bug's cause": "left for the agent to find", "must mention": ["the tests"]},
      "implement": {"task": "implement a function", "function": "{function}", "file": "{module_file}", "current body": "raise NotImplementedError", "specified by": "its docstring", "tests to pass": "{test_file}", "the tests": "stay unchanged", "must mention": ["the tests"]}
    },
    "elixir": {
      "prefix": "ex",
      "write_tests": {"task": "write unit tests", "language": "Elixir", "module": "{module_file}", "new test file": "{test_file}", "framework": "ExUnit", "cover": ["public functions", "edge cases", "errors"], "the module": "stays unchanged", "tests must pass with": "{test_command}", "must mention": ["the module"]},
      "fix_bug": {"task": "fix a bug", "language": "Elixir", "framework": "ExUnit", "failing tests": "{failing_tests}", "test file": "{test_file}", "bug is in": "{module_file}", "the tests": "stay unchanged", "the documentation": "stays unchanged", "the bug's cause": "left for the agent to find", "must mention": ["the tests", "the documentation"]},
      "implement": {"task": "implement a function", "language": "Elixir", "function": "{function}", "file": "{module_file}", "current body": "raise \"not implemented\"", "specified by": "its @doc", "tests to pass": "{test_file}", "the tests": "stay unchanged", "the documentation": "stays unchanged", "must mention": ["the tests", "the documentation"]},
      "change_note": {"file is": "{source_file}", "change": "modules renamed", "new names": "{modules}"}
    }
  },
  "messages": {
    "path_empty": {"kind": "error", "argument": "path", "problem": "empty"},
    "path_outside": {"kind": "error", "path": "{path}", "problem": "outside project folder", "project folder": "{root}"},
    "path_missing": {"kind": "error", "path": "{path}", "problem": "does not exist"},
