    "not_folder": {"kind": "error", "path": "{path}", "problem": "not a folder"},
    "content_type": {"kind": "error", "argument": "content", "required type": "string"},
    "edit_args": {"kind": "error", "arguments": ["old_string", "new_string"], "required type": "string", "old_string": "not empty"},
    "edit_count": {"kind": "error", "argument": "old_string", "found": "{n} times", "file": "{path}", "required": "exactly once"},
    "edits_shape": {"kind": "error", "argument": "edits", "required type": "non-empty array", "item fields": ["oldText", "newText"]},
    "edit_i_args": {"kind": "error", "edit number": "{i}", "fields": ["oldText", "newText"], "required type": "string", "oldText": "not empty"},
    "edit_i_count": {"kind": "error", "edit number": "{i}", "field": "oldText", "found": "{n} times", "file": "{path}", "required": "exactly once"},
    "bad_regex": {"kind": "error", "argument": "pattern", "problem": "invalid regular expression", "details": "{detail}"},
    "command_empty": {"kind": "error", "argument": "command", "problem": "empty"},
