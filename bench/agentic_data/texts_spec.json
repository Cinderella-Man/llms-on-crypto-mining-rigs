    "missing_param": {"kind": "error", "missing parameters": "{params}"},
    "no_result": {"kind": "error", "tool": "returned nothing"},
    "timeout": {"kind": "error", "tool": "did not finish", "time limit": "{seconds} seconds"},
    "wrote": {"kind": "result", "file": "{path}", "written": "whole file", "lines": "{n}"},
