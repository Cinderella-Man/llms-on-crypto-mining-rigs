# /etc/miner-llama/clocks.env: the boot-time clock service's settings on this rig (bench/mem_offset/README.md,
# "Overclocked at every boot"). KEY=value lines, '#' comments, no shell syntax and no $ expansion. Machine paths
# belong here, never in the repository. Every key the service does not read itself goes to the kit as it is (for
# example MMVQ_JOBS, PORT_BASE, TEMP_MAX, POWER_MAX, LEDGER, MEM_STEPS, CORE_CAP), so the names are climb.py's.

# The rig's soaked use profile: soak.py's soak/use.json from this rig's ladder, or this rig's published
# use-profile.json. Required; a profile from another rig is refused (PCI addresses, names and VBIOS must match).
PROFILE=/etc/miner-llama/clocks-profile.json

# The installed kit (install.sh puts it here).
KIT=/opt/miner-llama/mem_offset

# apply's per-card check: the engine's bin folder (with llama-server) and a check model of 2 to 4.5 GB, the same
# two the rig's climb and soak used. Required.
BIN=
CHECK_MODEL=

# The kit's work folder, a fresh one at every start; the last KEEP_WORKS starts' folders stay beside it.
WORK=/var/lib/miner-llama/clocks/work
KEEP_WORKS=5

# This rig's card set (optional, recommended): the output of `clocks_at_boot.py gpu-set-id` on this rig, a hash of
# its cards' PCI addresses and UUIDs. Identical rigs share PCI addresses, names and VBIOS, so without it a profile and
# config copied from another rig would pass; with it they are refused, and so is a rig whose card was changed.
GPU_SET_ID=

# The NVIDIA driver the profile was found on, e.g. 580.178.04 (optional, recommended): on another driver the
# service refuses, since the offsets' units may differ (measure them again with nvml_memoc.py units).
DRIVER=

# Seconds: the wait for the driver and the files at boot, and apply's limit (nine cards took 5 min 18 s).
DRIVER_WAIT=180
APPLY_LIMIT=2400
APPLY_ROUNDS=1

# Optional, off: after apply, the served model's whole-memory check (model_check.sh): MODEL_ROUNDS rounds on all
# cards with the release settings, each the stock hash stored in MODEL_REF/greedy-stock1.sha. A difference sets
# every card to 0. Make the reference once at stock with the same engine, model and settings (README).
MODEL_CHECK=0
MODEL=
MODEL_BIN=
SETTINGS=
MODEL_REF=/var/lib/miner-llama/model-ref
MODEL_ROUNDS=2
MODEL_LIMIT=3600
MODEL_PORT=8300

# Seconds between looks at the watchdog while the offsets are set; the watchdog's sample log is kept under this size.
POLL=10
WD_LOG_MAX_MB=64

# The state file (in /run: gone at the next boot, so it always describes this boot).
STATE=/run/miner-llama/clocks.state
