# Flint's MTP heads from agentic data run 1 (2026-10-27, seven GPUs): the settings bench/staircase_drafter/agentic_head.sh
# ran with, code at this repository's c5230ed. Set the folders, then:
#   . head-run1.env && nohup setsid bash "$HEAD_SH" > "$WORK/head.out" 2>&1 &
# Run order va, vb, q8: the export numbers sessions in this order, so a later export with more sessions keeps the
# earlier ids. RUN1 holds the three writers' run.sh folders (run1-va, run1-vb on vLLM, run1-q8 on llama-server).
RUN1=${RUN1:?folder with run1-va, run1-vb, run1-q8}
export HEAD_SH=${REPO:?this repository}/bench/staircase_drafter/agentic_head.sh
export WORK=${WORK:?output folder on a bulk disk}
export RUNS="$RUN1/run1-va $RUN1/run1-vb $RUN1/run1-q8"
export MODEL=${MODEL:?flint-Q8_0.gguf}
export HF_DIR=${HF_DIR:?RecursiveSI/flint small files}
export LLAMA=${LLAMA:?llama.cpp tree with build-cuda/bin/llama-staircase-dump}
export Q51_GEN=$REPO/release/flint-v2/reproduce/data/q51/gen.jsonl
export Q51=$REPO/release/flint-v2/reproduce/data/q51/prompts.jsonl
export FEATS_DIRS="$WORK/feats ${FEATS2:?a feature folder on a second disk}"
export DUMP_SETS="5,6 0,1,2 3,4"
export HEADS="gen:2:--general|nine:5:--general --cards 9e,9l,9l"
export MINUTES=240 CTX=4096 CHUNK=4096   # 16384 ran out of memory on the RTX 3090s
export Q51_SEQS=$REPO/release/flint-v2/reproduce/data/q51/seqs.txt   # Q51's dump input, rows numbered 0-37 (its ids repeat numbers across categories)
