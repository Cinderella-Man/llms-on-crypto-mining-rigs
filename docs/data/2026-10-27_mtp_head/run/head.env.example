# The settings of the 240-minute round (bench/staircase_drafter/agentic_head.sh at public c5230ed, training pieces of
# 4,096 targets from 0c84ad5 on). Fill in the paths; GPU numbers are the quant machine's (0-1 RTX 3080, 2 RTX 3090,
# 3-4 V100, 5-6 RTX 3090).
#   . head.env && bash "$BENCH/staircase_drafter/agentic_head.sh" > "$WORK/head.out" 2>&1
export BENCH=/path/to/llms-on-crypto-mining-rigs/bench
export WORK=/path/to/mtp-head/run1                  # export/, ids/, seqs/, flint/, vocab.npy, heads/, scores/, gguf/
# agentic data run 1's three writers (bench/agentic_data/run.sh folders), in this order: the export numbers sessions
# in it, so a later export with more sessions keeps the earlier ids
export RUNS="/path/to/run1-va /path/to/run1-vb /path/to/run1-q8"
export MODEL=/path/to/flint-Q8_0.gguf                 # Unsloth's Flint Q8_0 (the teacher of the dump)
export HF_DIR=/path/to/RecursiveSI/flint              # Flint's small files: LICENSE, chat_template.jinja, tokenizer
export LLAMA=/path/to/llama.cpp                       # a tree with build-cuda/bin/llama-staircase-dump and gguf-py
export Q51_GEN=/path/to/q51/gen.jsonl                 # Q51's 38 answers (Flint Q8_0)
export Q51_SEQS=/path/to/q51/seqs.txt                 # Q51's dump input, rows numbered 0-37 (its ids repeat numbers)
export Q51=/path/to/q51-prompts.jsonl                 # Q51's prompts, for the held-out checks of the gates
export FEATS_DIRS="/path/to/disk-a/feats /path/to/disk-b/feats"   # two disks: the trainers read them at random
export DUMP_SETS="5,6 0,1,2 3,4"                      # three dump instances; the first dumps Q51 and the held-out set
export HEADS="gen:2:--general|nine:5:--general --cards 9e,9l,9l"
export MINUTES=240 CTX=4096 CHUNK=4096                # 16,384-target pieces ran out of memory on a 24 GB card
