# Machine values for bench/agent_check/release_check.sh as used for Q215 (2026-11-03): the agent check of Swift-1.5
# GSQ-RCO Q2_0 on stock llama.cpp and Miner Llama v3. Copy, fill in your hosts and paths, keep the copy private:
#   set -a; . my-agent.env; set +a
#   STEPS=prep bench/agent_check/release_check.sh <out>                      # files, image, task validation; no rig
#   STEPS="run report collect" bench/agent_check/release_check.sh <out>      # the check
RIG=rig
CLIENT=<client alias>
RIG_PORT=8091
RELAY_PORT=8098
CLIENT_PORT=18391
PROXY_PORT=18392
CLIENT_DIR=<client folder>/bench
CLIENT_OUT=<client folder>/out
RIG_LOGDIR=<rig work folder>/agent-logs
STOCK_BIN=<builds>/llama.cpp-20261022-d77256999/bin/llama-server
REL_BIN=<builds>/llama.cpp-20261102-37e717ff6-pascal-p106-v3/bin/llama-server
MODEL=<disk>/models/flash_next/swift_q2_0/Swift-Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00003.gguf
CTX=65536
# Q213's split; no --pipe-depth on the v3 line (a hybrid model's recurrent state cannot step back); direct I/O loads
STOCK_ARGS="-b 2048 -ub 512 -ts 6,5,5,6,5,5,6,5,6 -fit off -lm dio"
REL_ARGS="-b 2048 -ub 512 -ts 6,5,5,6,5,5,6,5,6 -fit off -lm dio"
TIME_CAP_MIN=12
BUDGET_MIN_stock=40
BUDGET_MIN_rel=40
# the client at normal CPU priority (it shared its machine with low-priority jobs)
CPU_SHARES=1024
# the rig dipped to 230 MiB MemAvailable in the single requests, below the watchdog's default 400
MIN_AVAIL_MB=150
