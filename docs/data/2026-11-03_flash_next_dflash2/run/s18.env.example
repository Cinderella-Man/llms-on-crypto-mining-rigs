# Q561's machine values for ../../2026-11-03_flash_next_mtp/run/release_check_s12.sh and run/smoke_dflash.sh, with the
# paths as placeholders (Q226's s12.env.example plus the DFlash2 arms). Fill in, then
#   set -a; . s18.env; set +a
BENCH=bench/agent_check                 # this repository's agent check
RIG=rig2                                # the rig's ssh alias (non-interactive)
CLIENT=client                           # a Linux machine with Docker
RIG_PORT=8092
RELAY_PORT=8099
CLIENT_PORT=18393
PROXY_PORT=18394
CLIENT_DIR=/work/agent-check/s12/bench  # on the client (Q226's folder: its nodraft and mtp2 arms are the references)
CLIENT_OUT=/work/agent-check/s12/out    # on the client
RIG_LOGDIR=/mnt/models2/s18/agent-logs  # on the rig: a drive with room
REL_BIN=/opt/llama-builds/llama.cpp-20261103-2deed575e-pascal-p106-v3-dflash/bin/llama-server
MODEL=/mnt/models/flash_next/swift_q2_0/Swift-Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00003.gguf
DFLASH=/mnt/models/flash_next/dflash2/Qwen3.8-Flash-Next-DFlash2-Q8_0.gguf
GUARD=docs/data/2026-11-03_flash_next_mtp/run/mem_guard.sh
CTX=65536
# Q226's arms, for the report (their runs are in the client folder)
ARGS_nodraft="-b 2048 -ub 512 -ts 6,5,5,6,5,5,6,5,6 -fit off -lm dio"
ARGS_mtp="-b 2048 -ub 512 -ts 6,6,6,6,5,6,5,6,3 -fit off -lm dio -md /mnt/models/flash_next/mtp-Qwen3.8-Flash-Next-draft.gguf --spec-type draft-mtp --spec-draft-n-max 3"
ARGS_mtp2="$ARGS_mtp -otd token_embd=CUDA4 --spec-draft-n-ubatch 128 --no-host"
# Q561: the drafter on card 8 (the output head's card); smoke tests with --spec-draft-n-max 3, 2 and 4
ARGS_dflash2n3="-b 2048 -ub 512 -ts 6,6,6,6,5,6,5,6,3 -fit off -lm dio --no-host -md $DFLASH --spec-type draft-dflash --spec-draft-n-max 3 --spec-draft-n-ubatch 64 -devd CUDA8 -ngld 99"
# arm dflash2: stopped by the watchdog at the end of its first prompt; arm dflash2b: the same with -b 512
ARGS_dflash2="${ARGS_dflash2n3/--spec-draft-n-max 3/--spec-draft-n-max 2}"
ARGS_dflash2b="${ARGS_dflash2/-b 2048/-b 512}"
TIME_CAP_MIN=12
BUDGET_MIN_dflash2=40
BUDGET_MIN_dflash2b=40
CPU_SHARES=1024
MIN_AVAIL_MB=150
