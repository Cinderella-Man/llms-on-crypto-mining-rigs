# Q226's machine values for release_check_s12.sh and smoke_mtp.sh, with the paths as placeholders. Fill in, then
#   set -a; . s12.env; set +a
BENCH=bench/agent_check                 # this repository's agent check
RIG=rig2                                # the rig's ssh alias (non-interactive)
CLIENT=client                           # a Linux machine with Docker
RIG_PORT=8092
RELAY_PORT=8099
CLIENT_PORT=18393
PROXY_PORT=18394
CLIENT_DIR=/work/agent-check/s12/bench  # on the client
CLIENT_OUT=/work/agent-check/s12/out    # on the client
RIG_LOGDIR=/mnt/models2/s12/agent-logs  # on the rig: a drive with room, not the SSD that holds the n-gram table
REL_BIN=/opt/llama-builds/llama.cpp-20261102-37e717ff6-pascal-p106-v3/bin/llama-server
MODEL=/mnt/models/flash_next/swift_q2_0/Swift-Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00003.gguf
CTX=65536
# arm nodraft: Q215's v3 line (Q213's split, no --pipe-depth: a hybrid model's recurrent state cannot step back; direct
# I/O loads). Arm mtp: Q213's draft line (519 MiB projected on the fullest card)
ARGS_nodraft="-b 2048 -ub 512 -ts 6,5,5,6,5,5,6,5,6 -fit off -lm dio"
ARGS_mtp="-b 2048 -ub 512 -ts 6,6,6,6,5,6,5,6,3 -fit off -lm dio -md /mnt/models/flash_next/mtp-Qwen3.8-Flash-Next-draft.gguf --spec-type draft-mtp --spec-draft-n-max 3"
TIME_CAP_MIN=12
BUDGET_MIN_nodraft=40
BUDGET_MIN_mtp=40
CPU_SHARES=1024
MIN_AVAIL_MB=150
