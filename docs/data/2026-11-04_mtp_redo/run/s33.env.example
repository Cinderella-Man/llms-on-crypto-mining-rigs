# S33's arms, on top of S12's machine file (docs/data/2026-11-03_flash_next_mtp/run/s12.env.example, which also holds
# ARGS_mtp2). The engine: Miner Llama v3's base, as in S12 and S15.
REL_BIN=/opt/llama-builds/llama.cpp-20261102-37e717ff6-pascal-p106-v3/bin/llama-server
REL_ENV=
RIG_LOGDIR=/mnt/models2/s33/agent-logs
# mtpk: S12's draft line without S15's workarounds (the draft's token embeddings on the host, the default draft
# micro-batch, pinned host buffers); mtp2k: S15's mtp2 line (-otd token_embd=CUDA4 --spec-draft-n-ubatch 128 --no-host)
ARGS_mtpk="$ARGS_mtp"
ARGS_mtp2k="$ARGS_mtp2"
BUDGET_MIN_mtpk=40
BUDGET_MIN_mtp2k=40
MIN_AVAIL_MB=150
