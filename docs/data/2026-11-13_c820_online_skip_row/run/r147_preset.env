# R147 (Q1453): the Flash-Next v3 preset (release/flash-next-v3/settings.env) with LLAMA_SPEC_ADAPT's rule taken while
# drafting (C815, LLAMA_SPEC_ADAPT_ONLINE=2) on a draft of up to 6 tokens: FN82's est. v4 cost table and
# LLAMA_SPEC_ADAPT_DRAFT_MS=21.87 (C815's arm for C797), --spec-draft-p-min 0 (the rule needs it). Read by
# docs/data/2026-11-11_c615_draft_prefetch/run/rig_loads.sh; the skip (LLAMA_MTP_SKIP_LAST_ROW=2) is added per load.
PRESET_MODEL=Swift-Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00003.gguf
PRESET_DRAFT=mtp-Qwen3.8-Flash-Next-draft.gguf
PRESET_ENV="GGML_CUDA_MMVQ_PASCAL_KCOL_SMEM=32768 GGML_CUDA_MMVQ_PASCAL_KCOL_TABLE=0 LLAMA_HOP_CAST=q8_0 GGML_CUDA_HOP_STAGED=1 LLAMA_DRAFT_SHORTLIST=32768,8192,2 GGML_CUDA_KEEPALIVE=decode LLAMA_SPEC_ADAPT=1 LLAMA_SPEC_ADAPT_ONLINE=2 LLAMA_SPEC_ADAPT_COST=87.597,94.940,105.432,117.985,139.227,152.703,166.181 LLAMA_SPEC_ADAPT_DRAFT_MS=21.87"
PRESET_ARGS="-ngl 99 -fa on -c 65536 -np 1 -bs --ctx-checkpoints 4 --cache-ram 0 --jinja --reasoning-format deepseek --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 -b 2048 -ub 512 -ts 6,6,6,6,5,6,5,6,3 -fit off -lm dio --spec-type draft-mtp --spec-draft-n-max 6 --spec-draft-p-min 0 -otd token_embd=CUDA4 --spec-draft-n-ubatch 128 --no-host"
