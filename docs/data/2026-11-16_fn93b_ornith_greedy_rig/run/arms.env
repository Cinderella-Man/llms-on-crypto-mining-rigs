# FN93b's arms (Q1487), sourced before run/fn93b.sh: the v4 preset alone (the control, release/ornith-v4/settings.env),
# then the v4 preset with one candidate each, in load order. The six candidates are the ones R162's stack v4s set
# together (release/ornith-v4/README.md, "Candidates"); -b 4096 replaces the preset's -b 2048 in place.
export ARMS="v4 b4096 taper incall ckvram hop graphs"
export ARM_ARGS_b4096="-b 4096"
export ARM_ARGS_taper="--ubatch-taper short=600:64"
export ARM_ARGS_incall="--ctx-checkpoints-incall"
export ARM_ARGS_ckvram="--ctx-checkpoints-vram 4"
export ARM_ENV_hop="GGML_CUDA_HOP_STAGED=1"
export ARM_ENV_graphs="GGML_CUDA_GRAPHS_FORCE=1"
