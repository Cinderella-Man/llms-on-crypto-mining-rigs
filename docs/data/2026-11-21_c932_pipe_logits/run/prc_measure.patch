+// C932 measuring patch: the largest absolute and relative difference between two runs' logits, step by step
+struct diff_stats {
+    double max_abs = 0, max_rel = 0, max_logit = 0, min_margin = 1e30;
+    int    n_steps_diff = 0, n_argmax_diff = 0, first = -1;
+};
+static diff_stats compare_logits(const char * tag, const std::vector<float> & a, const std::vector<float> & b, int n_vocab,
+                                 int n_steps, bool per_step) {
+    diff_stats d;
+    for (int i = 0; i < n_steps; i++) {
+        const float * x = a.data() + (size_t) i*n_vocab;
+        const float * y = b.data() + (size_t) i*n_vocab;
+        double sa = 0, sr = 0;
+        int ax = 0, ay = 0;
+        for (int j = 0; j < n_vocab; j++) {
+            const double e = std::fabs((double) x[j] - (double) y[j]);
+            const double m = std::max(std::fabs((double) x[j]), std::fabs((double) y[j]));
+            sa = std::max(sa, e);
+            if (m > 0) { sr = std::max(sr, e/m); }
+            d.max_logit = std::max(d.max_logit, m);
+            if (x[j] > x[ax]) { ax = j; }
+            if (y[j] > y[ay]) { ay = j; }
+        }
+        float second = -INFINITY;
+        for (int j = 0; j < n_vocab; j++) { if (j != ax) { second = std::max(second, x[j]); } }
+        const double margin = (double) x[ax] - (double) second;
+        d.min_margin = std::min(d.min_margin, margin);
+        if (sa > 0) { d.n_steps_diff++; if (d.first < 0) { d.first = i; } }
+        d.n_argmax_diff += ax != ay;
+        d.max_abs = std::max(d.max_abs, sa);
+        d.max_rel = std::max(d.max_rel, sr);
+        if (per_step) {
+            printf("%s-STEP %d max_abs=%.3e max_rel=%.3e argmax=%d/%d margin=%.4f\n", tag, i, sa, sr, ax, ay, margin);
+        }
+    }
+    printf("%s n_steps=%d steps_diff=%d first_diff=%d max_abs=%.3e max_rel=%.3e max_logit=%.3f min_margin=%.4f argmax_diff=%d\n",
+           tag, n_steps, d.n_steps_diff, d.first, d.max_abs, d.max_rel, d.max_logit, d.min_margin, d.n_argmax_diff);
+    return d;
+}
