# Flash-Next's v3 release preset (T1, 2026-11-05): Miner Llama v3 -ladder5, Swift-1.5 GSQ-RCO Q2_0 as pmix-q2-fast,
# nine P106-090 cards, the MTP draft. Source this file, then start llama-server with LLAMA_ARGS:
#   set -a; . release/flash-next-v3/settings.env; set +a
#   $BIN/llama-server -m "$MODEL" $LLAMA_ARGS
# Measured (one run, agent check arm t1base, 12 bugfix tasks, -ladder5 1f7215948, which gives the same greedy output
# as 1551f5fe1): 12/12 passed, generation 20.75 tok/s, prompts 69.0 tok/s, time to first token median 7.60 s and p90
# 15.79 s, draft acceptance 0.714 (3.14 tokens a step), 2.45 minutes a task at equal work.
# Data and commands: docs/data/2026-11-05_release_flashnext/README.md.

# the k-column kernels for 2-5 token passes: shared-memory budget, no lookup table
GGML_CUDA_MMVQ_PASCAL_KCOL_SMEM=32768
GGML_CUDA_MMVQ_PASCAL_KCOL_TABLE=0
# the residual crosses each card boundary in Q8_0, through the manual staged hop
LLAMA_HOP_CAST=q8_0
GGML_CUDA_HOP_STAGED=1
# the MTP draft's output head reads a shortlist of the vocabulary
LLAMA_DRAFT_SHORTLIST=32768,8192,2
# a one-thread block per card holds the boost clock while a split decodes
GGML_CUDA_KEEPALIVE=decode

# the files (set MODELS to the folder that holds them): shards 1-2 of pmix-q2-fast with Swift's shard 3 (the n-gram
# table), and the MTP draft
MODEL=${MODELS:?}/swift_q2_0_pmix_fast/Swift-Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-pmix-fast-00001-of-00003.gguf
DRAFT=${MODELS:?}/mtp-Qwen3.8-Flash-Next-draft.gguf

# the server line: nine cards, 64k context, direct I/O loading, the draft at n-max 3 with its token embeddings on the
# fifth card, no host buffer for the draft; the sampling the agent check uses
LLAMA_ARGS="-ngl 99 -fa on -c 65536 -np 1 -bs --ctx-checkpoints 4 --cache-ram 0 --jinja --reasoning-format deepseek --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --metrics --no-webui -b 2048 -ub 512 -ts 6,6,6,6,5,6,5,6,3 -fit off -lm dio -md $DRAFT --spec-type draft-mtp --spec-draft-n-max 3 -otd token_embd=CUDA4 --spec-draft-n-ubatch 128 --no-host"
