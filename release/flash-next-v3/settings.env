# Miner Llama v3 preset: Qwen3.8-Flash-Next, UkisAI's Swift-1.5 GSQ-RCO Q2_0 (its n-gram table cut into a third
# shard) on nine P106-090 cards, 65,536-token context, the MTP draft.
# Build: pascal-p106-v3-b12076-ladder5 1551f5fe1. Measured on it: coding-agent check (arm t1swift, 12 bugfix tasks)
# 12/12, generation 20.40 tok/s, prompts 69.4 tok/s, first token per turn median 6.89 s and p90 15.89 s, draft
# acceptance 0.718 (3.15 tokens a step) (docs/data/2026-11-05_release_flashnext/).
# Use: . settings.env && env $PRESET_ENV llama-server -m "$MODELS/$PRESET_MODEL" -md "$MODELS/$PRESET_DRAFT" $PRESET_ARGS --host 127.0.0.1 --port 8080
# MODELS is the folder with shards 1-2, the link to shard 3 (the n-gram table) and the MTP draft.
PRESET_MODEL=Swift-Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00003.gguf
PRESET_DRAFT=mtp-Qwen3.8-Flash-Next-draft.gguf
# the k-column kernels for 2-5 token passes (shared-memory budget, no lookup table); the residual crosses each card
# boundary in Q8_0 through the staged hop; the MTP draft's output head reads a shortlist of the vocabulary; a one-thread
# block per card holds the boost clock while a split decodes
PRESET_ENV="GGML_CUDA_MMVQ_PASCAL_KCOL_SMEM=32768 GGML_CUDA_MMVQ_PASCAL_KCOL_TABLE=0 LLAMA_HOP_CAST=q8_0 GGML_CUDA_HOP_STAGED=1 LLAMA_DRAFT_SHORTLIST=32768,8192,2 GGML_CUDA_KEEPALIVE=decode"
PRESET_ARGS="-ngl 99 -fa on -c 65536 -np 1 -bs --ctx-checkpoints 4 --cache-ram 0 --jinja --reasoning-format deepseek --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 -b 2048 -ub 512 -ts 6,6,6,6,5,6,5,6,3 -fit off -lm dio --spec-type draft-mtp --spec-draft-n-max 3 -otd token_embd=CUDA4 --spec-draft-n-ubatch 128 --no-host"
