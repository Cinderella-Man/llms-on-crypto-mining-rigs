# Miner Llama v4 preset (v4r): Qwen3.8-Flash-Next, UkisAI's Swift-1.5 GSQ-RCO Q2_0 (its n-gram table cut into a
# third shard) on nine P106-090 cards, 65,536-token context, the MTP draft.
# Build: v4-rc2 (pascal-p106-v4 eb82916d3, upstream b12360 merged). Measured on it, the coding-agent check (12 bugfix
# tasks), two runs: 12/12 and 12/12, generation 27.61 and 26.67 tok/s, 2.37 and 2.43 minutes a task at equal work,
# against v3.0's 20.66 tok/s and 3.08 minutes (docs/data/2026-11-13_r156_agent_v4r/). At depth (the deep lane, two
# loads each): prompts 218.5 and 218.8 tok/s against v3.0's 91.2 and 91.4, decode 26.15 and 26.14 against 16.41 and
# 16.61 (docs/data/2026-11-13_r157_release_deep/).
# This is the line those runs started, less the harness's --metrics --no-webui, with the draft given by -md below.
# Use: . settings.env && env $PRESET_ENV llama-server -m "$MODELS/$PRESET_MODEL" -md "$MODELS/$PRESET_DRAFT" $PRESET_ARGS --host 127.0.0.1 --port 8080
# MODELS is the folder with shards 1-2, the link to shard 3 (the n-gram table) and the MTP draft.
# Every switch is described in docs/switches.md. "Rows" are registry rows in quants/experiments.md (Q...) and the rig
# checks that proved each switch on nine P106 cards (R..., in the data folders named in each row).
PRESET_MODEL=Swift-Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00003.gguf
PRESET_DRAFT=mtp-Qwen3.8-Flash-Next-draft.gguf

PRESET_ENV=
# v3.0's preset, unchanged (proved by v3.0's release check, docs/data/2026-11-05_release_flashnext/):
PRESET_ENV="$PRESET_ENV GGML_CUDA_MMVQ_PASCAL_KCOL_SMEM=32768"  # the k-column kernels of 2-5-token passes take activations up to 32 KB of shared memory (Q823)
PRESET_ENV="$PRESET_ENV GGML_CUDA_MMVQ_PASCAL_KCOL_TABLE=0"  # and run every shape, without the lookup table (Q824)
PRESET_ENV="$PRESET_ENV LLAMA_HOP_CAST=q8_0"  # the residual crosses each card boundary in Q8_0 (Q231, Q963)
PRESET_ENV="$PRESET_ENV GGML_CUDA_HOP_STAGED=1"  # each hop between cards goes through a pinned host ring (Q751)
PRESET_ENV="$PRESET_ENV LLAMA_DRAFT_SHORTLIST=32768,8192,2"  # the MTP draft's output head reads a shortlist of the vocabulary (Q592, Q635)
PRESET_ENV="$PRESET_ENV GGML_CUDA_KEEPALIVE=decode"  # a one-thread block per card holds the boost clock while a split decodes (Q1021, Q1045)
# R70's candidate and the switches proved on 2026-11-11 (docs/data/2026-11-10_v4_candidate/, docs/data/2026-11-11_r90_v4_vs_v3/):
PRESET_ENV="$PRESET_ENV GGML_CUDA_FATTN_SPARSE_PASCAL=1"  # sparse decode attention over the cells a QSA layer keeps (Q230, Q441; R70)
PRESET_ENV="$PRESET_ENV GGML_CUDA_FATTN_SPARSE_PASCAL_MIN_RATIO=1.0"  # from a cache as large as the kept cells (R70)
PRESET_ENV="$PRESET_ENV GGML_CUDA_FATTN_SPARSE_PASCAL_NSM=5"  # its launch shapes for the P106's 5 SMs (R70)
PRESET_ENV="$PRESET_ENV GGML_CUDA_MMVQ_PASCAL_DMT=1"  # IQ4_XS and Q4_K at 2-4 tokens: each weight read once for every token, exact (C722, Q1277; R79)
PRESET_ENV="$PRESET_ENV GGML_CUDA_MMVQ_PASCAL_Q5K_MT=1"  # Q5_K at 2-4 tokens (the output head in a verify), read once, exact (C690, Q1222; R75)
PRESET_ENV="$PRESET_ENV LLAMA_SAMPLING_TOP_K_ROWS=1"  # one top-k over all output rows in the card's sampling chain, the same tokens (C691, Q1223; R83)
PRESET_ENV="$PRESET_ENV LLAMA_QSA_INDEXER_ROWS=1"  # the QSA indexer reads each pool's key in its cache cell, not from a gather (C704, Q1244)
PRESET_ENV="$PRESET_ENV LLAMA_QSA_KPOOL_DEV=1"  # the QSA k-pool tables kept on each card, only changed rows sent (C100, Q640, Q1273)
# R72's v4c2: the rig rows of 2026-11-12 (docs/data/2026-11-12_r72_agent_v4c2/):
PRESET_ENV="$PRESET_ENV LLAMA_QSA_KPOOL_STAGE=1"  # the QSA k-pool's small inputs go up inside the tables' upload (C720, Q1275)
PRESET_ENV="$PRESET_ENV LLAMA_QSA_POOL_MASK_DEV=1"  # the QSA pool mask built on each card (C719, Q1274)
PRESET_ENV="$PRESET_ENV LLAMA_DRAFT_PREFETCH=1"  # the n-gram table rows a verify pass will read are asked for as soon as each token is drafted (C615, Q1100; R122)
PRESET_ENV="$PRESET_ENV LLAMA_VERIFY_PREPARE=2"  # the verify pass prepared while the last drafting pass runs, unchanged inputs not copied again (C738, Q1307; R122)
PRESET_ENV="$PRESET_ENV LLAMA_MTP_GRAPH_KEEP=1"  # the MTP draft keeps one graph per batch shape (C619, Q1104; R122)
PRESET_ENV="$PRESET_ENV LLAMA_KV_SEQ_RM_BOUND=1"  # removing a sequence's positions visits only the cells it can change, the same cells and head (C740, Q1309; R122)
PRESET_ENV="$PRESET_ENV LLAMA_SERVER_YIELD=2"  # a speculative step yields to the server's reader thread once, and wakes it only when a read waits (C741, Q1310; R122)
PRESET_ENV="$PRESET_ENV LLAMA_MTP_EMBD_FIRST=1"  # the draft's graph starts with its token rows' gather (C771, Q1357; R122)
PRESET_ENV="$PRESET_ENV LLAMA_MTP_DRAFT_CAP=1"  # no drafting pass whose token the server would cut at a reply's end (C744, Q1314; R122)
PRESET_ENV="$PRESET_ENV LLAMA_MTP_SKIP_LAST_ROW=1"  # the last drafting pass copies no hidden row to the host (C742, Q1311; R122)
PRESET_ENV="$PRESET_ENV GGML_CUDA_GRAPHS_FORCE=1"  # prompt micro-batches and the draft's catch-up captured as CUDA graphs without the two-call warm-up (C702, Q1240; R123a)
PRESET_ENV="$PRESET_ENV LLAMA_MTP_KV_ONLY=1"  # a draft pass with no output row writes only the draft layer's caches (C620, Q1105; R123a)
PRESET_ENV="$PRESET_ENV LLAMA_MTP_CATCHUP_OVERLAP=1"  # the draft catches up on a prompt call while the next call starts through the cards (C703, Q1242; R123a)
PRESET_ENV="$PRESET_ENV GGML_CUDA_MMVQ_PASCAL_Q3K_MT=1"  # Q3_K at 2-8 tokens read once, exact (C726, Q1285; R120b)
PRESET_ENV="$PRESET_ENV GGML_CUDA_MMVQ_PASCAL_GLU_MT=1"  # the shared expert's gate, up and SWIGLU at 2-8 tokens as one launch, exact (C757, Q1333; R120b)
PRESET_ENV="$PRESET_ENV GGML_CUDA_MMVQ_PASCAL_Q6K_MT=1"  # Q6_K at 2-4 tokens read once, exact (C727, Q1286; R120b)
PRESET_ENV="$PRESET_ENV LLAMA_SPEC_REJECT_STOP=1"  # probabilistic verification stops at an accepted end of turn (C675, Q1187; FN66)
PRESET_ENV="$PRESET_ENV LLAMA_DRAFT_EMBD_DEV=layer"  # the draft's token table on its layer's card, in place of v3.0's -otd token_embd=CUDA4 (C762, Q1340; R123b)
PRESET_ENV="$PRESET_ENV GGML_CUDA_FATTN_SPARSE_PASCAL_PROMPT=1"  # prompt micro-batches of up to 128 tokens on the sparse attention too (C705, Q1246; R123b)
# R142's v4c3 and the rows of 2026-11-13 (docs/data/2026-11-13_r142_agent_v4c3/, docs/data/2026-11-13_r156_agent_v4r/):
PRESET_ENV="$PRESET_ENV LLAMA_SCHED_PER_SIZE_RESERVE=2"  # the draft's schedulers planned once over the whole memory, again after a change of cards (C803, Q1407; R130; C818, Q1427; R143)
PRESET_ENV="$PRESET_ENV GGML_CUDA_MMVF_F32_MT=1"  # the F32 shared-expert gate at 4-8 tokens on mul_mat_vec_f, not cuBLAS, exact (C807, Q1413; R132)
PRESET_ENV="$PRESET_ENV GGML_CUDA_KEEPALIVE_EAGER=1"  # the keep-alive block ends before a kernel's first launch on a card, so the launch does not wait ~1 s for it (C811, C817, Q1417, Q1426; R140)
PRESET_ENV="$PRESET_ENV LLAMA_MTP_HROW_LAZY=1"  # the hidden-row buffer's second half made only when a prompt is cut into several calls (C813, Q1422; R139)
PRESET_ENV="$PRESET_ENV GGML_CUDA_MMVQ_PASCAL_KCOL_EXACT=1"  # the k-column kernel keeps every Q3_K, IQ4_NL, Q2_0 and Q8_0 product of 2-8 tokens, so each token gets its one-token sums (C805, Q1411; R126)
PRESET_ENV="$PRESET_ENV GGML_CUDA_MMVQ_PASCAL_KCOL_SKIP=q4_0,q5_0"  # the shared expert's Q4_0/Q5_0 downs at 2-4 tokens on the multi-column kernel, exact (C755, Q1456; R150; C828, Q1470; R155)
PRESET_ENV=${PRESET_ENV# }

PRESET_ARGS=
# v3.0's line (every flag explained in release/flash-next-v3/README.md) with -b 2048 -> 4096, -otd token_embd=CUDA4
# removed and --spec-draft-n-ubatch 128 -> 512:
PRESET_ARGS="$PRESET_ARGS -ngl 99 -fa on -c 65536 -np 1 -bs --ctx-checkpoints 4 --cache-ram 0 --jinja --reasoning-format deepseek"
PRESET_ARGS="$PRESET_ARGS --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0"  # the makers' sampling
PRESET_ARGS="$PRESET_ARGS -b 4096 -ub 512"  # prompt calls of 4,096 tokens in micro-batches of 512 (R123b)
PRESET_ARGS="$PRESET_ARGS -ts 6,6,6,6,5,6,5,6,3 -fit off -lm dio"  # the layer split by memory; direct I/O load (Q547)
PRESET_ARGS="$PRESET_ARGS --spec-type draft-mtp --spec-draft-n-max 3"  # the MTP draft, three tokens a step
PRESET_ARGS="$PRESET_ARGS --spec-draft-n-ubatch 512"  # the draft's micro-batch: 512 reads prompts 3.7 % faster than 128 (R53); upstream #32078 needs the flag
PRESET_ARGS="$PRESET_ARGS --no-host"
PRESET_ARGS="$PRESET_ARGS --spec-draft-sampling probabilistic --spec-draft-p-min 0"  # token-by-token rejection of the draft, the reply's distribution unchanged (R70)
PRESET_ARGS="$PRESET_ARGS --ctx-checkpoints-vram 4"  # a slot's newest four checkpoints on the cards (Q440, Q548; R70)
PRESET_ARGS="$PRESET_ARGS --ctx-checkpoints-incall"  # checkpoints taken inside a prompt's call, not by cutting it: -18.99 % prompt time (C217, Q1306; R85)
PRESET_ARGS="$PRESET_ARGS --ubatch-taper short=600:64"  # a prompt of at most 600 tokens in micro-batches of 64 (Q771; R60)
PRESET_ARGS=${PRESET_ARGS# }
