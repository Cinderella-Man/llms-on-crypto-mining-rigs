# Miner Llama v3 preset: Flint, Unsloth Q8_0 on nine P106-090 cards, 262,144-token context.
# Build: pascal-p106-v3-b12076-ladder5 1551f5fe1. Measured on 1f7215948 (the same code but the row-guard fix):
# coding-agent check 45.9 tok/s, 12/12 (docs/data/2026-11-05_release_regression/).
# Use: . settings.env && env $PRESET_ENV llama-server -m "$MODELS/$PRESET_MODEL" $PRESET_ARGS --host 127.0.0.1 --port 8080
PRESET_MODEL=flint-Q8_0.gguf
PRESET_ENV=""
PRESET_ARGS="--alias flint -ngl 99 -fa on -c 262144 -np 1 -b 512 -ub 128 -ts 6,6,5,5,6,5,5,6,6 -bs --ctx-checkpoints 4 --cache-ram 0 --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --pipe-depth 4"
