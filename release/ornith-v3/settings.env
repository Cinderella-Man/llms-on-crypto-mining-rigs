# Miner Llama v3 preset: Ornith-1.5-122B, valid1 (N2P/N3P experts, Q5_0 output layer) on nine P106-090 cards,
# 49,152-token context.
# Build: pascal-p106-v3-b12076-ladder5 1551f5fe1. Measured on 1f7215948 (the same code but the row-guard fix):
# coding-agent check 16.3 tok/s, 12/12, with the keep-alive (14.9 without it; docs/data/2026-11-05_release_regression/).
# Use: . settings.env && env $PRESET_ENV llama-server -m "$MODELS/$PRESET_MODEL" $PRESET_ARGS --host 127.0.0.1 --port 8080
PRESET_MODEL=Ornith-1.5-122B-N2P-N3P-valid1-headQ5_0.gguf
PRESET_ENV="GGML_CUDA_KEEPALIVE=decode"
PRESET_ARGS="-ngl 99 -fa on -c 49152 -np 1 -bs --ctx-checkpoints 4 --cache-ram 0 --jinja --reasoning-format deepseek --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0 -b 2048 -ub 512 -ts 6,6,6,6,5,5,5,5,6 -fit off"
